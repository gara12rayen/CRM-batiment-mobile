EXPO_PUBLIC_APP_URL=https://app.example.com

# Adresse de l'API NestJS de la version web (même base PostgreSQL), toujours terminée par /api/v1
# - téléphone sur le même Wi-Fi que le PC : http://IP-DU-PC:3000/api/v1   (pas localhost)
# - émulateur Android : http://10.0.2.2:3000/api/v1
# - navigateur (npm run web / touche w) : http://localhost:3000/api/v1
# - production : https://api.votre-domaine.fr/api/v1
# Jamais de mot de passe de base ni de clé ici : tout ce qui commence par EXPO_PUBLIC_ est lisible dans l'application.
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000/api/v1
