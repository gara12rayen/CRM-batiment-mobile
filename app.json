{
  "expo": {
    "name": "CRM Bâtiment",
    "slug": "crm-batiment-mobile",
    "scheme": "crm-batiment",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
   "plugins": [
  "expo-router",
  "expo-secure-store",
  [
    "expo-camera",
    {
      "cameraPermission": "Autoriser CRM Bâtiment à accéder à la caméra pour scanner les QR codes."
    }
  ]
],
    "experiments": {
      "typedRoutes": true
    }
  }
}
