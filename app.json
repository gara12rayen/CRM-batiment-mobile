{
  "expo": {
    "name": "CRM Bâtiment",
    "slug": "crm-batiment-mobile",
    "scheme": "crm-batiment",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "android"
    ],
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.omarb17.crmbatimentmobile"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
